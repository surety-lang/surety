{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["\"", "\""]],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(e:|[^#/].*:)\\s*$",
    "decreaseIndentPattern": "^\\s*[}\\]]\\s*$"
  },
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*"
}
