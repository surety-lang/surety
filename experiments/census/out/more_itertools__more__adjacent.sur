// draft
// drafted
type Item = { value: Int, satisfies: Bool }
// drafted
type Flagged = { near: Bool, item: Item }
// drafted
type AdjacentError = { message: Text }

// drafted
distance_error: AdjacentError = {message: "distance must be at least 0"}

adjacent(items: Item[], distance: Int) -> Result<Flagged[], AdjacentError>
	note "pair each item with whether it satisfies the predicate or lies within distance places of an item that does; the predicate is called once per item, so its result arrives as each item's satisfies"
	# The output is Ok exactly when the distance is at least 0.
	distance >= 0 <-> (exactly_one Ok(_) in out)
	# Every error output is distance_error.
	all Err(e) in out: e == distance_error
	# An Ok output has exactly as many elements as there are input items.
	all Ok(res) in out: len(res) == len(items)
	# An Ok output's items are the input items, in the input's order.
	all Ok(res) in out: res.item == items
	# In an Ok output, every element whose position is at most distance places from the position of
	# an item that satisfies the predicate is flagged near.
	// reaching for: a binder over positions of res, so the line could read: for every position i of
	// res and every position j of items where items at j satisfies and abs(i - j) <= distance, the
	// element of res at i is near. Occurrences carry positions, but only `before` can compare them,
	// and nothing measures how far apart two positions are.
	# In an Ok output, every element flagged near is at most distance places from the position of
	# some item that satisfies the predicate.
	// reaching for: a binder over positions of res, so the line could read: for every position i of
	// res whose element is near, there is a position j of items where items at j satisfies and
	// abs(i - j) <= distance. As above, the notation can say that one occurrence comes before
	// another, but not how many places apart they are.
	// example wanted: no items at distance 1: the empty input, nothing to flag
	// example wanted: values 0 to 5 with only 3 satisfying, distance 1: the docstring's first case,
	// a window of one place either side
	// example wanted: values 0 to 5 with only 3 satisfying, distance 2: the docstring's second
	// case, the window reaches the last item
	// example wanted: values 0 to 5 with only 3 satisfying, distance 0: the window is the item
	// itself, so near is exactly satisfies
	// example wanted: values 0 to 5 with nothing satisfying, distance 1: no window anywhere
	// example wanted: values 0 to 5 with only 0 satisfying, distance 2: the window is cut off at
	// the start of the list
	// example wanted: values 0 to 9 with 2 and 6 satisfying, distance 2: two windows that meet, and
	// positions beyond both
	// example wanted: values 0 to 3 with only 1 satisfying, distance 10: a distance longer than the
	// list flags every item
	// example wanted: values [3, 3, 5] with both 3s satisfying, distance 1: duplicate items,
	// positions decide, not values
	// example wanted: values 0 to 5 with only 3 satisfying, distance -1: below the threshold, the
	// error case
