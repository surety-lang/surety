// draft
// drafted
type Value = { id: Id, is_none: Bool, iterable: Bool, type_names: Text[], items: Id[] }

always_iterable(obj: Value, base_type: Option<Text[]>) -> Id[]
	note "Iterate over obj's items, giving nothing for None and obj alone when obj is not iterable or is an instance of base_type; the Python default for base_type is str and bytes, passed here as Some of those two names."
	# If obj is None, the output is empty, whatever base_type is.
	obj.is_none -> len(out) == 0
	# If obj is not None, base_type is given, and some name in obj's type_names is in base_type, the
	# output is obj's id alone.
	// reaching for: a binder that opens an Option the way Ok(x) opens a Result (`Some(bt)` is not
	// accepted in the quantifier head), so I could write: all Some(bt) in base_type: all n in
	// obj.type_names where not obj.is_none and n in bt: len(out) == 1 and obj.id in out
	# If obj is not None and is not an instance of base_type, or base_type is None, and obj is
	# iterable, the output has the same elements as obj's items, in the same order.
	// reaching for: a way to name the list inside base_type when it is Some, and to use "no name in
	// obj.type_names is in that list" as a condition that is not the last operand on its line, so I
	// could write: (not obj.is_none and obj.iterable and (base_type == None or no name in
	// obj.type_names is in the given base_type list)) -> (out same_order_as obj.items and obj.items
	// same_order_as out)
	# If obj is not None and is not an instance of base_type, or base_type is None, and obj is not
	# iterable, the output is obj's id alone.
	// reaching for: the same opened Option and non-final quantifier, so I could write: (not
	// obj.is_none and not obj.iterable and (base_type == None or no name in obj.type_names is in
	// the given base_type list)) -> (len(out) == 1 and obj.id in out)
	// example wanted: the tuple (1, 2, 3) with the default base_type; obj is iterable and neither
	// str nor bytes, so the output is its items in order
	// example wanted: the int 1 with the default base_type; obj is not iterable, so it is wrapped
	// alone
	// example wanted: None with the default base_type; the None case decides it before any other
	// check
	// example wanted: None with a base_type naming NoneType; the None check comes first, so the
	// base_type match does not wrap it
	// example wanted: an empty list, not None, with the default base_type; it is iterable with no
	// items, which is distinct from the None case
	// example wanted: the text foo with the default base_type; str is in base_type, so it is
	// treated as a unit
	// example wanted: the text foo with base_type None; no special handling, so it is iterated
	// character by character
	// example wanted: the dict with key a, once with the default base_type and once with base_type
	// naming dict; the first iterates its keys, the second treats it as a unit
