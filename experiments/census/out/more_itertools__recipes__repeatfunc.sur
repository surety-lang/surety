// draft
// drafted
type RepeatError = { code: Text, display: Text }

// drafted
too_few_results_err: RepeatError = {code: "e-too-few-results", display: "times asks for more calls than there are results"}

repeatfunc(results: Int[], times: Option<Int>) -> Result<Int[], RepeatError>
	note "call function with args repeatedly and yield each call's result; results stands for what the successive calls return (function and args fixed), and with times None the endless iterable is the results drawn so far"
	# The output is an error exactly when times is given and is more than the number of results.
	// reaching for: one line saying out is an Err if and only if times holds a value t with t > len(results). Both sides need a quantifier: `exactly_one Err(_) in out` on one, `any Some(t) in times: t > len(results)` on the other. A quantifier has to be the last operand on a line, so they cannot meet across `<->`. Moving the iff inside `all Some(t) in times` drops the None case, where the output must not be an error. It fits once the times side is an abbreviation (`too_many = any Some(t) in times: t > len(results)`, then `too_many <-> exactly_one Err(_) in out`), and that is the author's line to add. It also assumes `Some(t)` is accepted as the binder for the present side of an Option.

	# Every error output is too_few_results_err.
	all Err(e) in out: e == too_few_results_err

	# When times is given and the output is Ok, the output is the results from position 0 up to but
	# not including times.
	all Some(t) in times: all Ok(res) in out: res == results[0 .. t]

	# When times is None and the output is Ok, the output is the results, all of them, in the order
	# the calls produced them.
	times == None -> all Ok(res) in out: res == results
	// example wanted: the add doctest, times 4 over four results that are all 8; what decides it is
	// the slice taking all four
	// example wanted: times 0 over a non-empty list of results; the slice from 0 to 0 decides it
	// example wanted: a negative times over a non-empty list of results; the slice clamps rather
	// than counting from the end
	// example wanted: times exactly equal to the number of results; the exact threshold of the
	// error claim
	// example wanted: times one more than the number of results; the other side of the threshold
	// example wanted: times None over an empty list of results; nothing drawn yet
	// example wanted: times None over results that differ from call to call, as with randrange;
	// order of the calls decides it
