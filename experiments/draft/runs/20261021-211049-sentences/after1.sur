// draft
// drafted
type Order = { amount: Int, customer_email: Text }

drop_orders_over_100(orders: Order[]) -> Order[]
	note "remove every order whose amount is greater than 100 and keep the rest"
	# Every output order has an amount of at most 100.
	# Every output order is one of the input orders, unchanged.
	# Every input order with an amount of at most 100 is in the output.
	# Every input order left out of the output has an amount greater than 100.
	# An order whose amount is exactly 100 is kept.
	# An input order that appears more than once with an amount of at most 100 is kept as many times as it appears.
	# The output keeps the kept orders in the same order as the input.
