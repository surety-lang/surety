// draft
// drafted
type Marked = { is_first: Bool, is_last: Bool, item: Text }

mark_ends(items: Text[]) -> Marked[]
	note "pair every item with whether it is the first and whether it is the last, keeping the items in order"
	# The output has exactly as many elements as the input has items.
	len(out) == len(items)
	# The output's items are the input items, in the input's order.
	out.item == items
	# The first output element is marked first.
	all m in out[0 .. 1]: m.is_first
	# No output element after the first is marked first.
	none m in out[1 .. len(out)]: m.is_first
	# The last output element is marked last.
	all m in out[len(out) - 1 .. len(out)]: m.is_last
	# No output element before the last is marked last.
	none m in out[0 .. len(out) - 1]: m.is_last
	// example wanted: the empty list; the output is empty.
	// example wanted: a single item; the one element is both the first and the last.
	// example wanted: items ["A", "B", "C"], the docstring's case; one first, one middle, one last.
	// example wanted: items ["A", "A"]; the two equal items must still get different flags by
	// position, not by value.
