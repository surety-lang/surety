(fn combine (in (c {email:Text,first_name:Text,last_name:Text})) (out {email:Text,name:Text}) (props (in (. c first_name) (. out name)) (in (. c last_name) (. out name))) (examples (e (in (rec (email (text "test@test.com")) (first_name (text "")) (last_name (text "Show")))) (out (rec (name (text "Show")) (rest)))) (e (in (rec (email (text "test@test.com")) (first_name (text "Joe")) (last_name (text "Shmoe")))) (out (rec (name (text "Joe Shmoe")) (rest))))))